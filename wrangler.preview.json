{
  "name": "smarttrade-ai-preview",
  "main": "cloudflare/src/preview.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./preview-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET_QUOTA",
        "class_name": "MarketQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_market_quota",
      "new_sqlite_classes": [
        "MarketQuota"
      ]
    }
  ]
}
